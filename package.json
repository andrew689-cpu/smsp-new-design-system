{
  "name": "smsp-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design system for PT. Sumber Makmur Surya Perkasa (SMS Perkasa)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:verify": "tsx scripts/build-tokens.ts --verify",
    "showcase:artifact": "tsx scripts/build-artifact.ts",
    "typecheck": "tsc --noEmit",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:contract": "tsx scripts/check-contract.ts",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:contract",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run tokens:verify && npm run typecheck && npm run lint && npm run test",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "simple-git-hooks@2.14.0": true
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  }
}
